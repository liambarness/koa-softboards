---
const products = [
  {
    name: "KO'A Big Boy Bodyboard",
    image: '/images/big-boy-bodyboard.webp',
    width: 1590,
    height: 1590,
    href: 'https://konasurfco.com/collections/koa-softboards/products/koa-big-boy-bodyboard',
  },
  {
    name: "KO'A Lemon Pop Softboard",
    image: '/images/lemon-pop-softboard.webp',
    width: 900,
    height: 900,
    href: 'https://konasurfco.com/collections/koa-softboards/products/koa-lemon-pop-softboard',
  },
];
---

<section class="relative w-full px-3 py-16 sm:px-6 sm:py-24 text-center" data-theme="light">
  <div class="relative mx-auto max-w-7xl">
    <div class="grid gap-8 justify-items-center md:grid-cols-2">
      {products.map((product) => (
        <div class="card card-border w-full max-w-2xl flex-1" data-theme="dark">
          <figure>
            <img
              src={product.image}
              alt={product.name}
              loading="lazy"
              decoding="async"
              width={product.width}
              height={product.height}
            />
          </figure>
          <div class="card-body gap-4 items-center text-center">
            <h3 class="font-black card-title sm:text-2xl">{product.name}</h3>
            <div class="card-actions items-center">
              <a class="btn btn-secondary px-4 py-2.5 h-auto min-h-0" href={product.href}>
                <span>Buy Now</span>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
